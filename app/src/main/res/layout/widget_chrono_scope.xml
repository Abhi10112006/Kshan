<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_canvas_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Kshan Chronometer Widget" />

    <!-- Native Live Ticking HH:MM:SS Remainder Chronometer for 4x2 & 4x1 formats -->
    <Chronometer
        android:id="@+id/widget_live_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="22dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:countDown="true"
        android:fontFamily="monospace"
        android:textColor="#00F2FE"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Fallback & semantic text views for accessibility / tests -->
    <LinearLayout
        android:id="@+id/widget_fallback_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kshan" />

        <TextView
            android:id="@+id/widget_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Countdown" />

        <TextView
            android:id="@+id/widget_days_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0" />

        <TextView
            android:id="@+id/widget_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAYS" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="remaining" />
    </LinearLayout>
</FrameLayout>
